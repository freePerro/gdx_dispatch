{
  "id": "/",
  "name": "GDX Dispatch",
  "short_name": "GDX",
  "description": "Jobs, planner, customers, and billing for the field and the office.",
  "start_url": "/mobile",
  "scope": "/",
  "display": "standalone",
  "background_color": "#0e1525",
  "theme_color": "#121c2f",
  "icons": [
    { "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "/icons/icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "/icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "share_target": {
    "action": "/mobile/planner",
    "method": "GET",
    "enctype": "application/x-www-form-urlencoded",
    "params": {
      "title": "share_title",
      "text": "share_text",
      "url": "share_url"
    }
  },
  "shortcuts": [
    {
      "name": "Quick note",
      "url": "/mobile/planner?capture=1",
      "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Planner",
      "url": "/mobile/planner",
      "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Jobs",
      "url": "/mobile/jobs",
      "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }]
    }
  ]
}
